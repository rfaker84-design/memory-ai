{
  "version": "2.0",
  "statement": [
    {
      "sid": "MediaObjectReadWrite",
      "effect": "allow",
      "action": [
        "name/cos:PutObject",
        "name/cos:GetObject",
        "name/cos:HeadObject",
        "name/cos:DeleteObject"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-media-prod-1442603693/media/*"
      ]
    },
    {
      "sid": "BackupObjectReadWriteMultipartAndListParts",
      "effect": "allow",
      "action": [
        "name/cos:PutObject",
        "name/cos:GetObject",
        "name/cos:HeadObject",
        "name/cos:DeleteObject",
        "name/cos:InitiateMultipartUpload",
        "name/cos:UploadPart",
        "name/cos:CompleteMultipartUpload",
        "name/cos:AbortMultipartUpload",
        "name/cos:ListParts"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/memoryai-postgresql/daily/*",
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/memoryai-postgresql/weekly/*"
      ]
    },
    {
      "sid": "BackupListMultipartUploadsDailyPrefix",
      "effect": "allow",
      "action": [
        "name/cos:ListMultipartUploads"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/*"
      ],
      "condition": {
        "string_like": {
          "cos:prefix": "memoryai-postgresql%2Fdaily%2F*"
        }
      }
    },
    {
      "sid": "BackupListMultipartUploadsWeeklyPrefix",
      "effect": "allow",
      "action": [
        "name/cos:ListMultipartUploads"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/*"
      ],
      "condition": {
        "string_like": {
          "cos:prefix": "memoryai-postgresql%2Fweekly%2F*"
        }
      }
    },
    {
      "sid": "BackupListDailyExactPrefix",
      "effect": "allow",
      "action": [
        "name/cos:GetBucket"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/*"
      ],
      "condition": {
        "string_equal": {
          "cos:prefix": "memoryai-postgresql%2Fdaily%2F"
        }
      }
    },
    {
      "sid": "BackupListWeeklyExactPrefix",
      "effect": "allow",
      "action": [
        "name/cos:GetBucket"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1442603693:memoryai-pg-backup-prod-1442603693/*"
      ],
      "condition": {
        "string_equal": {
          "cos:prefix": "memoryai-postgresql%2Fweekly%2F"
        }
      }
    }
  ]
}
