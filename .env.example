# =============================================================================
# 1. Supabase????
# =============================================================================
# Production runtime uses server-side PostgreSQL. Supabase variables are legacy
# export-only inputs and must not be consumed by formal application routes.
DATABASE_URL=postgresql://memoryai_app:replace-with-a-secret@127.0.0.1:5432/memoryai
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
LEGACY_SUPABASE_URL=https://your-project.supabase.co
LEGACY_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
LEGACY_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ?????https://supabase.com/dashboard
# ?????Supabase Dashboard ? Settings ? API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ????????????????????
# ?????Supabase Dashboard ? Settings ? API ? service_role secret
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 2. DeepSeek AI????
# =============================================================================
# ?????https://platform.deepseek.com
# ?????DeepSeek ??? ? API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 3. ??? COS??? ? ?????
# =============================================================================
# ?????https://console.cloud.tencent.com/cos
# ??????????? ? ???? ? API????
TENCENT_SECRET_ID=replace-with-secret-id
TENCENT_SECRET_KEY=replace-with-secret-key

# Tencent Cloud console naming aliases. Use the runtime key names above unless
# a deployment adapter explicitly maps these aliases.
TENCENTCLOUD_SECRET_ID=replace-with-secret-id
TENCENTCLOUD_SECRET_KEY=replace-with-secret-key

# COS ?????
# ??????????? ? ???? ? ?????
COS_BUCKET=your-bucket-name-1234567890
COS_REGION=ap-guangzhou
# COS ?????????????????
# COS_DOMAIN=https://your-bucket.cos.ap-guangzhou.myqcloud.com

# Server-only private media bucket. Never expose these as NEXT_PUBLIC_* values.
COS_MEDIA_BUCKET=memoryai-private-media-1234567890
COS_MEDIA_REGION=ap-guangzhou
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_AUDIO_BYTES=104857600

# Server-only PostgreSQL backup destination (a separate private bucket is recommended).
COS_BACKUP_BUCKET=memoryai-private-backups-1234567890
COS_BACKUP_REGION=ap-guangzhou
MEMORYAI_PG_BACKUP_ROOT=/home/ubuntu/memoryai-backups/postgresql
MEMORYAI_PG_DATABASE=memoryai

