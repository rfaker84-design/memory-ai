# =============================================================================
# 8. 火山引擎豆包 (LLM) — 优先AI模型
# =============================================================================
# 注册: https://console.volcengine.com/ark
# 获取: 火山引擎控制台 → 豆包大模型 → API密钥
VOLC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# =============================================================================
# 9. 火山引擎 TTS (语音合成)
# =============================================================================
# 注册: https://console.volcengine.com/speech
# 获取: 语音技术控制台 → 应用管理 → AppID + Token
VOLC_TTS_APP_ID=xxxxxxxxxxxx
VOLC_TTS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 10. 即梦AI (数字人人脸生成)
# =============================================================================
# 注册: https://jimeng.jianying.com
# 获取: 即梦AI开放平台 → API密钥
JIMENG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 11. OpenAI (备选LLM)
# =============================================================================
# 如不使用火山豆包，可配置OpenAI
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 12. 应用公开URL
# =============================================================================
# 部署后的公网访问地址
# NEXT_PUBLIC_APP_URL=https://yijianmemory.vercel.app

# =============================================================================
# 13. Frozen AI Provider Selection
# =============================================================================
# Keep provider selection in the frozen Provider Layer. Defaults remain mock.
LLM_PROVIDER=mock
# Supported: mock | tencent
TTS_PROVIDER=mock

# Tencent Cloud SMS (server-only; do not reuse COS credentials)
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# Authentication security (server-only)
AUTH_VERIFICATION_PEPPER=
SESSION_SECRET=
AUTH_ALLOWED_ORIGIN=https://yijianmemory.cn
AUTH_TRUST_NGINX_PROXY=true
