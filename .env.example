# =============================================================================
# 13. Frozen AI Provider Selection
# =============================================================================
# Production runtime identity. Staging uses its separate documented contract;
# never point a production process at staging capability variables.
DEPLOYMENT_ENV=production
# Keep provider selection in the frozen Provider Layer. Production requires
# DeepSeek LLM and Tencent TTS; isolated staging is the only mock exception.
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
# Supported: mock | tencent
TTS_PROVIDER=tencent

# Tencent Cloud SMS (server-only; do not reuse COS credentials)
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# Authentication security (server-only)
AUTH_VERIFICATION_PEPPER=
SESSION_SECRET=
AUTH_ALLOWED_ORIGIN=https://yijianmemory.cn
# Fail closed by default. Set true in production only after Nginx is verified to
# replace (not append) X-Real-IP with $remote_addr.
AUTH_TRUST_NGINX_PROXY=false
AUTH_PROXY_LOOPBACK_ONLY=false

# WeChat Open Platform website login (server-only and capability-scoped).
# Redirect URI must be the exact HTTPS callback on AUTH_ALLOWED_ORIGIN.
WECHAT_AUTH_APP_ID=
WECHAT_AUTH_APP_SECRET=
WECHAT_AUTH_REDIRECT_URI=https://yijianmemory.cn/api/auth/wechat/callback
# Independent 32+ byte random secret. Do not reuse SMS, Session, or payment keys.
WECHAT_AUTH_IDENTITY_PEPPER=

# Quarantined legacy 49 yuan / 30 day / 100 reply card. Never set in production.
# It requires both the exact flag and an exact, comma-separated test account list.
LEGACY_CHAT_COMMERCE_TEST_MODE=false
LEGACY_CHAT_COMMERCE_TEST_ACCOUNTS=

# First-party aggregated business funnel access (server-only; 32+ random chars).
# This token is for a protected internal consumer, never a browser bundle.
BUSINESS_METRICS_ACCESS_TOKEN=
# Sprint21 commerce remains test-only until merchant and store approvals exist.
COMMERCE_TEST_MODE=false
# Minimum 32 bytes in non-production test environments only.
COMMERCE_TEST_CALLBACK_SECRET=
# Minimum 48 bytes; protects the read-only internal reconciliation endpoint.
COMMERCE_RECONCILIATION_ACCESS_TOKEN=

# =============================================================================
# 14. Isolated internal betas (server-only and fail-closed)
# =============================================================================
# These switches must never be set on the public production deployment. Internal
# beta deployments must use an isolated test database and explicit synthetic
# test-account external IDs. Capabilities remain off when any value is absent.
# MEMORYAI_DEPLOYMENT_TIER=internal-beta
# MEMORYAI_BETA_DATA_SCOPE=isolated-test
# MEMORYAI_LONG_TERM_MEMORY_BETA_ENABLED=false
# MEMORYAI_LONG_TERM_MEMORY_BETA_TEST_USER_IDS=
