# =============================================================================
# 13. Frozen AI Provider Selection
# =============================================================================
# Production runtime identity. Staging uses its separate documented contract;
# never point a production process at staging capability variables.
DEPLOYMENT_ENV=production
# Production mutating capability kill switches. Each must be changed to the
# exact value true only through an approved deployment; omitted/malformed
# values are disabled in production.
YIJIAN_REGISTRATION_ENABLED=false
YIJIAN_VIDEO_GENERATION_ENABLED=false
YIJIAN_COMMERCE_PURCHASE_ENABLED=false
MEMORYAI_FREE_CHAT_DAILY_LIMIT=
# Keep provider selection in the frozen Provider Layer. Production requires
# DeepSeek LLM and Tencent TTS; isolated staging is the only mock exception.
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
# Supported: mock | tencent
TTS_PROVIDER=tencent

# External video Provider. Keep blank until the account, commercial terms,
# retention/deletion terms, region, and a separately approved runtime are in place.
VIDU_API_KEY=
# Production video artifacts use a dedicated COS bucket. Leave every field
# blank until the approved worker deployment; the Worker rejects missing or
# non-COS values and never falls back to local Staging storage.
YIJIAN_VIDEO_WORKER_ENABLED=false
VIDEO_WORKER_CONCURRENCY=1
VIDEO_ARTIFACT_STORAGE_PROVIDER=cos
COS_VIDEO_ARTIFACT_BUCKET=
COS_VIDEO_ARTIFACT_REGION=
VIDEO_WORKER_EVIDENCE_ROOT=
VIDEO_ARTIFACT_SIGNING_SECRET=
VIDEO_ARTIFACT_SIGNING_SECRET_PREVIOUS=
VIDEO_ARTIFACT_SIGNING_SECRET_PREVIOUS_VALID_UNTIL=
VIDEO_ARTIFACT_PLAYBACK_BASE_URL=https://yijianmemory.cn/api/first-presence-video/playback
AI_CONTENT_MARKING_PROVIDER_NAME=
AI_CONTENT_MARKING_PROVIDER_CODE=

# Tencent Cloud SMS (server-only; do not reuse COS credentials)
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# WeChat Pay and paid-experience configuration. These capability inputs remain
# blank and fail closed until the merchant account, callback domain and launch
# approval are complete. Never paste PEM files into tracked configuration.
YIJIAN_EXPERIENCE_PRODUCT_ID=
YIJIAN_EXPERIENCE_PRICE_FEN=
YIJIAN_EXPERIENCE_DURATION_DAYS=
YIJIAN_EXPERIENCE_CHAT_QUOTA=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM_BASE64=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERTIFICATE_PEM_BASE64=

# Authentication security (server-only)
AUTH_VERIFICATION_PEPPER=
# Optional bounded identity-pepper rotation. New digests always use the
# current KID; previous fields must be set together, cover the session window,
# and be removed after the audited retirement.
AUTH_VERIFICATION_PEPPER_KID=current
AUTH_VERIFICATION_PEPPER_PREVIOUS=
AUTH_VERIFICATION_PEPPER_PREVIOUS_KID=
AUTH_VERIFICATION_PEPPER_PREVIOUS_VALID_UNTIL=
SESSION_SECRET=
# Optional bounded rotation; new Sessions are always signed by SESSION_SECRET.
# Keep exactly one previous key for at most seven days plus 30 seconds, then
# remove all three previous variables after its verified retirement.
SESSION_SECRET_KID=current
SESSION_SECRET_PREVIOUS=
SESSION_SECRET_PREVIOUS_KID=
SESSION_SECRET_PREVIOUS_VALID_UNTIL=
AUTH_ALLOWED_ORIGIN=https://yijianmemory.cn
# Fail closed by default. Set true in production only after Nginx is verified to
# replace (not append) X-Real-IP with $remote_addr.
AUTH_TRUST_NGINX_PROXY=false
AUTH_PROXY_LOOPBACK_ONLY=false

# Candidate-only account rights controls. Both remain fail-closed until the
# corresponding migration and isolated runtime have separately been approved.
ACCOUNT_DATA_EXPORT_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false
AUTH_SESSION_REVOCATION_ENFORCED=false
# May only shorten the maximum 7 / 30 / 90 day customer-content windows.
ACCOUNT_DELETION_CONTENT_RETENTION_DAYS=7
ACCOUNT_DELETION_PROVIDER_RETENTION_DAYS=30
ACCOUNT_DELETION_BACKUP_RETENTION_DAYS=90
# Financial records are archived only to a separately provisioned database.
# Leave these blank until a compliance-approved isolated archive is available.
# The candidate 1095-day default is subject to the external legal and accounting gate.
ACCOUNT_DELETION_FINANCIAL_ARCHIVE_DATABASE_URL=
ACCOUNT_DELETION_FINANCIAL_ARCHIVE_DATABASE_SSL=false
ACCOUNT_DELETION_FINANCIAL_ARCHIVE_HMAC_KEY=
ACCOUNT_DELETION_FINANCIAL_RETENTION_DAYS=

# WeChat Open Platform website login (server-only and capability-scoped).
# Redirect URI must be the exact HTTPS callback on AUTH_ALLOWED_ORIGIN.
WECHAT_AUTH_APP_ID=
WECHAT_AUTH_APP_SECRET=
WECHAT_AUTH_REDIRECT_URI=https://yijianmemory.cn/api/auth/wechat/callback
# Independent 32+ byte random secret. Do not reuse SMS, Session, or payment keys.
WECHAT_AUTH_IDENTITY_PEPPER=

# Quarantined legacy 49 yuan / 30 day / 100 reply card. Never set in production.
# It requires both the exact flag and an exact, comma-separated test account list.
LEGACY_CHAT_COMMERCE_TEST_MODE=false
LEGACY_CHAT_COMMERCE_TEST_ACCOUNTS=

# First-party aggregated business funnel access (server-only; 32+ random chars).
# This token is for a protected internal consumer, never a browser bundle.
BUSINESS_METRICS_ACCESS_TOKEN=
# Aggregate-only operations summary/alert pull access (server-only; 32+ random chars).
OPERATIONS_METRICS_ACCESS_TOKEN=
# Optional 15-minute rotation overlap. Set both or neither; an invalid pair fails closed.
OPERATIONS_METRICS_ACCESS_TOKEN_PREVIOUS=
OPERATIONS_METRICS_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
# Required exact JSON threshold set for /api/internal/operations/alerts. Each value is a non-negative integer.
OPERATIONS_ALERT_THRESHOLDS_JSON={"videoActive":20,"videoSubmissionUncertain":0,"videoQualityPending":10,"videoManualReview":10,"videoTerminalP95Seconds":900,"videoCommittedCreditsLast24Hours":100,"commercePendingOrders":20,"commerceRefundsAwaitingResolution":5,"accountDeletionRunnableTasks":20,"accountDeletionFailedTasks":0,"chatFailedLast24Hours":10,"chatPendingOverFiveMinutes":0}
# Sprint21 commerce remains test-only until merchant and store approvals exist.
COMMERCE_TEST_MODE=false
# Minimum 32 bytes in non-production test environments only.
COMMERCE_TEST_CALLBACK_SECRET=
# Minimum 48 bytes; protects the read-only internal reconciliation endpoint.
COMMERCE_RECONCILIATION_ACCESS_TOKEN=
# Optional one-token handoff. A previous token needs both fields and may be
# accepted for at most 15 minutes; remove both after verified retirement.
COMMERCE_RECONCILIATION_ACCESS_TOKEN_PREVIOUS=
COMMERCE_RECONCILIATION_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
# Minimum 48 bytes; protects the manual refund-review control plane.
REFUND_REVIEW_ACCESS_TOKEN=
REFUND_REVIEW_ACCESS_TOKEN_PREVIOUS=
REFUND_REVIEW_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
# Complaint-review controls are disabled until a separate operator is approved.
# A prior token, if used, is accepted for at most 15 minutes.
YIJIAN_REPORT_REVIEW_INTERNAL_ENABLED=false
REPORT_REVIEW_ACCESS_TOKEN=
REPORT_REVIEW_ACCESS_TOKEN_PREVIOUS=
REPORT_REVIEW_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
REPORT_REVIEW_ACCOUNT=
# Separate, server-only video human-review and uncertain-reconciliation planes.
# Keep both disabled until their isolated runtime contract and operators are
# separately approved. Tokens must be distinct and at least 48 bytes.
YIJIAN_VIDEO_REVIEW_INTERNAL_ENABLED=false
VIDEO_REVIEW_ACCESS_TOKEN=
VIDEO_REVIEW_ACCESS_TOKEN_PREVIOUS=
VIDEO_REVIEW_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
YIJIAN_VIDEO_REVIEW_ACCOUNT=
YIJIAN_VIDEO_RECONCILIATION_INTERNAL_ENABLED=false
VIDEO_RECONCILIATION_ACCESS_TOKEN=
VIDEO_RECONCILIATION_ACCESS_TOKEN_PREVIOUS=
VIDEO_RECONCILIATION_ACCESS_TOKEN_PREVIOUS_VALID_UNTIL=
YIJIAN_VIDEO_RECONCILIATION_ACCOUNT=

# =============================================================================
# 14. Isolated internal betas (server-only and fail-closed)
# =============================================================================
# These switches must never be set on the public production deployment. Internal
# beta deployments must use an isolated test database and explicit synthetic
# test-account external IDs. Capabilities remain off when any value is absent.
# MEMORYAI_DEPLOYMENT_TIER=internal-beta
# MEMORYAI_BETA_DATA_SCOPE=isolated-test
# MEMORYAI_LONG_TERM_MEMORY_BETA_ENABLED=false
# MEMORYAI_LONG_TERM_MEMORY_BETA_TEST_USER_IDS=
# Qwen voice cloning is Staging internal-beta only. Supply the key and exact
# workspace endpoint only through the Staging secret manager; never set either
# variable on the public production deployment.
# MEMORYAI_QWEN_AUDIO_TTS_FLASH_VOICE_CLONE_BETA_ENABLED=false
# MEMORYAI_QWEN_AUDIO_TTS_FLASH_VOICE_CLONE_BETA_TEST_USER_IDS=
# DASHSCOPE_API_KEY=
# DASHSCOPE_VOICE_CLONE_ENDPOINT=https://<workspace>.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/customization
