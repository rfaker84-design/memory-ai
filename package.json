    "cos-nodejs-sdk-v5": "^2.15.4",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "next": "^15.3.3",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "postprocessing": "^6.39.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tencentcloud-sdk-nodejs-asr": "^4.1.247",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
