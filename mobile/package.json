{
  "name": "memoryai-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MemoryAI native mobile host for the existing Next.js product core.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:debug": "vite build --mode debug",
    "sync": "tsx scripts/sync-mobile.ts release",
    "sync:debug": "tsx scripts/sync-mobile.ts debug",
    "android:debug": "npm run sync:debug && cd android && gradlew.bat assembleDebug",
    "android:release-audit": "npm run sync && npm run verify:config && cd android && gradlew.bat assembleRelease",
    "android:install": "cd android && gradlew.bat installDebug",
    "ios:sync": "npm run sync && cap sync ios",
    "ios:open": "cap open ios",
    "verify:config": "tsx scripts/verify-mobile-config.ts",
    "test": "npm run typecheck && npm run test:secure-session-contract && npm run test:android-release-signing-contract && npm run test:incomplete-ta-resume && npm run test:video-opportunity && npm run test:navigation-contract && npm run test:pickup && npm run test:safety-copy && npm run test:ios-media-contract",
    "test:secure-session-contract": "tsx --test scripts/session-origin.test.ts",
    "test:android-release-signing-contract": "tsx --test scripts/android-release-signing-contract.test.ts",
    "test:incomplete-ta-resume": "tsx --test src/product/incomplete-memory.test.ts",
    "test:video-opportunity": "tsx --test src/product/video-opportunity.test.ts",
    "test:navigation-contract": "tsx --test src/navigation-contract.test.ts",
    "test:pickup": "tsx --test src/product/pickup.test.ts",
    "test:safety-copy": "tsx --test src/safety-copy-contract.test.ts",
    "test:ios-media-contract": "tsx --test scripts/ios-media-contract.test.ts"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
