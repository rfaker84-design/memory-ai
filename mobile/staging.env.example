# The Debug App remains packaged in the APK but identifies as this local HTTPS
# origin. Do not use an IP address, HTTP, server.url, or a production hostname.
MOBILE_APP_ORIGIN_HOST=app.staging.yijianmemory.cn

# It must be the same-site API sibling of MOBILE_APP_ORIGIN_HOST. The app UI is
# always loaded from the packaged bundle; this is an API origin only.
VITE_MOBILE_API_BASE_URL=https://api.staging.yijianmemory.cn

# Obtain a 48+ byte rotating staging access token from the isolated staging
# secret manager. This is packaged into Debug only; never set it for Release.
VITE_MOBILE_STAGING_ACCESS_TOKEN=replace-with-rotating-staging-token

# Optional debug-only HTTPS video used to exercise native MediaStore/Photos saving.
# Do not define this for a formal release build.
VITE_MOBILE_TEST_VIDEO_URL=
